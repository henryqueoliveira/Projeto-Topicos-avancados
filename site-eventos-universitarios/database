CREATE DATABASE db_gerenciamento_eventos;

CREATE TABLE if not exists usuarios (
                          id SERIAL PRIMARY KEY,
                          nome VARCHAR(150) NOT NULL,
                          email VARCHAR(150) UNIQUE NOT NULL,
                          senha_hash VARCHAR(255) NOT NULL,
                          tipo_perfil VARCHAR(30) NOT NULL CHECK (tipo_perfil IN ('admin', 'organizador', 'palestrante', 'participante')),
                          criado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE if not exists eventos (
                         id SERIAL PRIMARY KEY,
                         titulo VARCHAR(200) NOT NULL,
                         descricao TEXT,
                         data_inicio TIMESTAMP NOT NULL,
                         data_fim TIMESTAMP NOT NULL,
                         local VARCHAR(150) NOT NULL,
                         organizador_id INT REFERENCES usuarios(id) ON DELETE CASCADE,
                         criado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE if not exists atividades (
                            id SERIAL PRIMARY KEY,
                            evento_id INT REFERENCES eventos(id) ON DELETE CASCADE,
                            titulo VARCHAR(200) NOT NULL,
                            descricao TEXT,
                            tipo_atividade VARCHAR(50) NOT NULL CHECK (tipo_atividade IN ('palestra', 'minicurso', 'mesa-redonda', 'workshop')),
                            data_hora_inicio TIMESTAMP NOT NULL,
                            data_hora_fim TIMESTAMP NOT NULL,
                            vagas_limite INT NOT NULL,
                            palestrante_id INT REFERENCES usuarios(id) ON DELETE SET NULL,
                            criado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE if not exists inscricoes (
                            id SERIAL PRIMARY KEY,
                            usuario_id INT REFERENCES usuarios(id) ON DELETE CASCADE,
                            atividade_id INT REFERENCES atividades(id) ON DELETE CASCADE,
                            data_inscricao TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                            status_presenca BOOLEAN DEFAULT FALSE,
                            CONSTRAINT unique_inscricao UNIQUE (usuario_id, atividade_id)
);

CREATE TABLE if not exists submissoes (
                            id SERIAL PRIMARY KEY,
                            evento_id INT REFERENCES eventos(id) ON DELETE CASCADE,
                            autor_id INT REFERENCES usuarios(id) ON DELETE CASCADE,
                            titulo_artigo VARCHAR(250) NOT NULL,
                            resumo TEXT NOT NULL,
                            arquivo_url VARCHAR(255) NOT NULL,
                            status VARCHAR(30) DEFAULT 'pendente' CHECK (status IN ('pendente', 'aprovado', 'rejeitado')),
                            criado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

